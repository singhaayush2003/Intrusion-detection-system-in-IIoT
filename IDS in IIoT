{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":3319673}],"dockerImageVersionId":31401,"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\n\n# 1. Register the sequence window packer\nclass EdgeIIoTSequenceDataset(Dataset):\n    def __init__(self, features, labels, sequence_length=10):\n        min_len = min(len(features), len(labels))\n        self.features = torch.tensor(features[:min_len], dtype=torch.float32)\n        self.labels = torch.tensor(labels[:min_len], dtype=torch.long)\n        self.sequence_length = sequence_length\n\n    def __len__(self):\n        if len(self.features) < self.sequence_length: return 0\n        return len(self.features) - self.sequence_length\n\n    def __getitem__(self, idx):\n        x = self.features[idx : idx + self.sequence_length]\n        y = self.labels[idx + self.sequence_length - 1]\n        return x, y\n\n# 2. Register the 1D-CNN + LSTM Network Architecture\nclass CNNLSTMModel(nn.Module):\n    def __init__(self, num_classes, input_dim):\n        super(CNNLSTMModel, self).__init__()\n        self.conv1d = nn.Conv1d(in_channels=input_dim, out_channels=64, kernel_size=3, padding=1)\n        self.relu = nn.ReLU()\n        self.maxpool = nn.MaxPool1d(kernel_size=2, stride=2)\n        self.lstm = nn.LSTM(input_size=64, hidden_size=128, num_layers=2, batch_first=True, dropout=0.3)\n        self.fc = nn.Linear(128, num_classes)\n        \n    def forward(self, x):\n        x = x.permute(0, 2, 1)  # Shape: (Batch, Features, Seq)\n        x = self.conv1d(x)\n        x = self.relu(x)\n        x = self.maxpool(x)\n        x = x.permute(0, 2, 1)  # Shape: (Batch, Seq, Channels)\n        lstm_out, _ = self.lstm(x)\n        out = lstm_out[:, -1, :]\n        return self.fc(out)\n\nprint(\"🏗️ Dataset and Model structures successfully registered on the GPU runtime!\")","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"!find /kaggle/input/ -name \"*.csv\"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import LabelEncoder, StandardScaler\nfrom torch.utils.data import DataLoader\n\nprint(\"⏳ Loading the real Edge-IIoTset file natively from Kaggle storage...\")\n# VERIFIED KAGGLE PATH STRUCTURE\ndf = pd.read_csv('/kaggle/input/datasets/mohamedamineferrag/edgeiiotset-cyber-security-dataset-of-iot-iiot/Edge-IIoTset dataset/Selected dataset for ML and DL/DNN-EdgeIIoT-dataset.csv', low_memory=False)\n\nprint(\"🎲 Shuffling dataset vectors globally...\")\ndf = df.sample(frac=1, random_state=42).reset_index(drop=True)\n\n# Isolate threat target metrics\ny_raw = df['Attack_type'].values\nle = LabelEncoder()\ny_encoded = le.fit_transform(y_raw)\n\n# Extract and isolate pure numerical matrices dynamically\nX_df = df.drop(columns=['Attack_type'], errors='ignore')\nX_numeric_df = X_df.select_dtypes(include=[np.number])\nX_raw = X_numeric_df.values\n\nprint(\"⚖️ Normalizing features via Z-score scaling...\")\nscaler_features = StandardScaler()\nX_scaled = scaler_features.fit_transform(X_raw.astype(np.float32))\n\nprint(\"✂️ Executing chronological partition matrix mapping...\")\nsplit_train = int(len(X_scaled) * 0.7)\nsplit_val = int(len(X_scaled) * 0.85)\n\nX_train, y_train = X_scaled[:split_train], y_encoded[:split_train]\nX_val, y_val = X_scaled[split_train:split_val], y_encoded[split_train:split_val]\n\nprint(\"📦 Packing records into overlapping sequential sliding windows...\")\nsequence_length = 10\ntrain_dataset = EdgeIIoTSequenceDataset(X_train, y_train, sequence_length=sequence_length)\nval_dataset = EdgeIIoTSequenceDataset(X_val, y_val, sequence_length=sequence_length)\n\ntrain_dataloader = DataLoader(train_dataset, batch_size=256, shuffle=False)\nval_dataloader = DataLoader(val_dataset, batch_size=256, shuffle=False)\n\nprint(f\"\\n🎉 DATA MATRICES FULLY RESTORED:\")\nprint(f\"🔹 Train Batches: {len(train_dataloader)} | Val Batches: {len(val_dataloader)}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import copy\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\n\nprint(\"🏗️ Re-initializing model structures on the hardware accelerator...\")\n# Force verification that the newly attached Kaggle GPU is active\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n\ninput_features = X_train.shape[1]  # Aligns perfectly to your 43 numeric features\nnum_classes = len(le.classes_)\n\nmodel = CNNLSTMModel(num_classes=num_classes, input_dim=input_features)\nmodel = model.to(device)\n\ncriterion = nn.CrossEntropyLoss()\noptimizer = optim.AdamW(model.parameters(), lr=0.001, weight_decay=1e-4)\nscaler = torch.amp.GradScaler('cuda')\n\nnum_epochs = 15\nbest_val_loss = float('inf')\npatience = 3  \npatience_counter = 0\nbest_model_wts = copy.deepcopy(model.state_dict())\n\nprint(f\"🔥 Launching Real-World T4 Training Timeline ({num_epochs} Epochs MAX) ...\")\nprint(f\"📡 Processing {len(train_dataloader)} batches per epoch via FP16 Mixed Precision on {device.type.upper()}.\")\n\nfor epoch in range(num_epochs):\n    print(f\"\\n--- Epoch {epoch+1}/{num_epochs} ---\")\n    \n    # --- TRAINING PHASE ---\n    model.train()\n    running_loss = 0.0\n    correct_preds = 0\n    total_preds = 0\n    \n    for batch_idx, (inputs, targets) in enumerate(train_dataloader):\n        # Cast inputs and target matrices straight onto the GPU device\n        inputs, targets = inputs.to(device), targets.to(device)\n        \n        optimizer.zero_grad()\n        \n        # Enable FP16 Mixed Precision Forward Pass\n        with torch.amp.autocast('cuda'):\n            outputs = model(inputs)\n            loss = criterion(outputs, targets)\n            \n        # Backward Pass scaled gracefully to guard against underflow gradients\n        scaler.scale(loss).backward()  \n        scaler.step(optimizer)         \n        scaler.update()                \n        \n        running_loss += loss.item() * inputs.size(0)\n        _, predicted = torch.max(outputs, 1)\n        total_preds += targets.size(0)\n        correct_preds += (predicted == targets).sum().item()\n        \n        # Fast GPU Progress Tracker\n        if batch_idx % 1500 == 0:\n            print(f\"Batch {batch_idx:4d}/{len(train_dataloader)} | Current Batch Loss: {loss.item():.4f}\")\n            \n    epoch_train_loss = running_loss / len(train_dataset)\n    epoch_train_acc = (correct_preds / total_preds) * 100\n    print(f\"🥇 Train Loss: {epoch_train_loss:.4f} | Train Acc: {epoch_train_acc:.2f}%\")\n    \n    # --- VALIDATION PHASE ---\n    model.eval()\n    val_loss = 0.0\n    val_correct = 0\n    val_total = 0\n    \n    with torch.no_grad():\n        for inputs, targets in val_dataloader:\n            inputs, targets = inputs.to(device), targets.to(device)\n            \n            with torch.amp.autocast('cuda'):\n                outputs = model(inputs)\n                loss = criterion(outputs, targets)\n                \n            val_loss += loss.item() * inputs.size(0)\n            _, predicted = torch.max(outputs, 1)\n            val_total += targets.size(0)\n            val_correct += (predicted == targets).sum().item()\n            \n    epoch_val_loss = val_loss / len(val_dataset)\n    epoch_val_acc = (val_correct / val_total) * 100\n    print(f\"🥈 Val Loss: {epoch_val_loss:.4f} | Val Acc: {epoch_val_acc:.2f}%\")\n    \n    # --- AUTOMATIC SAVING AND EARLY STOPPING PROTECTIONS ---\n    if epoch_val_loss < best_val_loss:\n        best_val_loss = epoch_val_loss\n        best_model_wts = copy.deepcopy(model.state_dict())\n        torch.save(best_model_wts, 'best_cnnlstm_model.pth')\n        print(\"💾 New best validation loss achieved! Model weight checkpoint saved.\")\n        patience_counter = 0  \n    else:\n        patience_counter += 1\n        print(f\"⚠️ No improvement in validation loss. Stagnation counter: {patience_counter}/{patience}\")\n        \n    if patience_counter >= patience:\n        print(\"\\n🛑 Early stopping triggered! Training stopped to protect model generalization.\")\n        break\n\n# Wrap up optimization steps cleanly\nmodel.load_state_dict(best_model_wts)\nprint(\"\\n🎉 Pipeline execution completed! Optimal weights loaded back into memory.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import torch\nimport numpy as np\nimport pandas as pd\nfrom sklearn.metrics import classification_report\n\nprint(\"🔮 Generating model predictions across the validation subset matrix...\")\nmodel.eval()\nall_preds = []\nall_targets = []\n\n# Extract true hybrid model predictions from the validation loader\nwith torch.no_grad():\n    for inputs, targets in val_dataloader:\n        inputs = inputs.to(device)\n        with torch.amp.autocast('cuda'):\n            outputs = model(inputs)\n        _, predicted = torch.max(outputs, 1)\n        \n        all_preds.extend(predicted.cpu().numpy())\n        all_targets.extend(targets.numpy())\n\nall_preds = np.array(all_preds)\nall_targets = np.array(all_targets)\n\n# Decode numerical targets back to original threat strings\ntarget_names = [str(cls) for cls in le.classes_]\n\nprint(\"\\n📊 Calculating multi-class threat matrix metrics...\")\nhybrid_report = classifi